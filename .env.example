# -----------------------------------------------------------------------------
# GIA PHẢ OS - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn: Chép (copy) file này thành ".env.local" rồi điền giá trị thật.

# Tên của ứng dụng web được hiển thị cho người dùng
SITE_NAME="Gia Phả OS"

# Connection string của Neon Postgres (Vercel Storage > Neon, hoặc neon.tech)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require"

# Auth.js — sinh bằng lệnh: openssl rand -base64 32
AUTH_SECRET="your-random-secret"

# Google OAuth (Google Cloud Console > Credentials > OAuth Client ID)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Vercel Blob (tự thêm khi tạo Blob store trên Vercel; chạy local thì dùng `vercel env pull`)
BLOB_READ_WRITE_TOKEN="your-blob-token"

# (Tuỳ chọn) Domain hiển thị banner "Website Demo"
DEMO_DOMAIN="giapha-os.homielab.com"
